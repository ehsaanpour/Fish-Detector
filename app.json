{
  "expo": {
    "name": "Market Fish Inspector",
    "slug": "fish-market-inspector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fishdetector.marketapp"
    },
    "android": {
      "package": "com.fishdetector.marketapp",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A192F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses photos to identify fish species and inspect freshness.",
          "cameraPermission": "The app accesses the camera to identify fish species and inspect freshness in real time."
        }
      ],
      "./plugins/withAndroidSplits.js"
    ]
  }
}
